{
  "name": "agtail",
  "version": "0.4.0",
  "description": "tail -f for local coding agents: follow Claude Code, Codex, ChatGPT desktop and pi sessions live",
  "keywords": [
    "claude-code",
    "codex",
    "chatgpt",
    "pi",
    "coding-agent",
    "tail",
    "cli",
    "monitor"
  ],
  "author": "c4pt0r",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c4pt0r/agtail.git"
  },
  "homepage": "https://github.com/c4pt0r/agtail#readme",
  "type": "module",
  "bin": {
    "agtail": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import fs from 'node:fs'; fs.mkdirSync('dist/web',{recursive:true}); fs.copyFileSync('src/web/index.html','dist/web/index.html')\"",
    "dev": "node src/cli.ts",
    "prepare": "tsc && node --input-type=module -e \"import fs from 'node:fs'; fs.mkdirSync('dist/web',{recursive:true}); fs.copyFileSync('src/web/index.html','dist/web/index.html')\"",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
